# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Never commit the filled-in file.

# Project URL (server-side only — no NEXT_PUBLIC_ prefix)
SUPABASE_URL=

# "anon" (or "publishable") key — NOT the service_role key. The app queries as
# the signed-in user, and row-level security limits each user to their own rows.
# Kept server-side anyway; nothing in the browser talks to Supabase directly.
SUPABASE_ANON_KEY=
